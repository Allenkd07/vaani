# Copy to backend/.env and fill in. Every variable without "(optional)" is required:
# the app refuses to start and names any that are missing.

# User, password and database must match the root .env used by docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5433/speech_to_text

# Speech-to-text provider. Only "gemini" is implemented.
STT_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe-live
# VERBATIM keeps every word; SMART removes filler words and formats the text.
STT_MODE=VERBATIM
# (optional) Comma-separated BCP-47 codes to bias recognition, e.g. hi-IN,en-IN. Empty = automatic detection.
STT_LANGUAGES=

# (optional) App-wide live sessions per day, reset at midnight Pacific like the Gemini quota.
# Set to ~80% of the model's requests-per-day limit (aistudio.google.com/rate-limit). Empty = no cap.
STT_DAILY_SESSION_LIMIT=

# (optional) Comma-separated origins allowed to call the API cross-origin. Empty = same origin only,
# which is enough locally (Vite proxies /api and /ws) and in production (FastAPI serves the frontend).
CORS_ORIGINS=
